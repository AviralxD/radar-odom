# Template: hercules_eval.launch.py adds a path and pose display for each run
Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Global Options:
    Fixed Frame: world
    Background Color: 30; 30; 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid (10 m)
      Enabled: true
      Cell Size: 10
      Plane Cell Count: 40
    - Class: rviz_default_plugins/Path
      Name: Ground truth (green)
      Enabled: true
      Color: 60; 220; 90
      Line Style: Billboards
      Line Width: 0.4
      Topic:
        Value: /radom/viz/gt_path
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Pose
      Name: Ground truth now
      Enabled: true
      Color: 60; 220; 90
      Shape: Arrow
      Shaft Length: 3.00
      Shaft Radius: 0.40
      Head Length: 1.20
      Head Radius: 0.90
      Topic:
        Value: /radom/viz/gt_pose
        Depth: 5
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Top down
      Scale: 6
      X: 0
      Y: 0
